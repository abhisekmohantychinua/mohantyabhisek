{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/components",
    "src/features",
    "src/lib",
    "src/models",
    "src/schemas"
  ],
  "entryPointStrategy": "expand",
  "out": "out",
  "name": "mohantyabhisek.com",
  "readme": "README.md",
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.stories.tsx",
    "**/*.e2e.ts"
  ],
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "githubPages": true,
  "theme": "default",
  "lightHighlightTheme": "github-light",
  "darkHighlightTheme": "github-dark",
  "navigationLinks": {
    "Website": "https://mohantyabhisek.com",
    "API Reference": "https://abhisekmohantychinua.github.io/mohantyabhisek/api-docs/",
    "GitHub": "https://github.com/abhisekmohantychinua/mohantyabhisek"
  },
  "sidebarLinks": {
    "Website": "https://mohantyabhisek.com",
    "GitHub": "https://github.com/abhisekmohantychinua/mohantyabhisek"
  },
  "navigation": {
    "includeCategories": true,
    "includeGroups": false,
    "includeFolders": true,
    "compactFolders": true,
    "excludeReferences": true
  },
  "categorizeByGroup": false,
  "hideGenerator": true
}

{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/components",
    "src/features",
    "src/lib",
    "src/models",
    "src/schemas"
  ],
  "entryPointStrategy": "expand",
  "out": "out",
  "name": "Abhisek — Codebase Documentation",
  "readme": "docs/api/README.md",
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.stories.tsx",
    "**/*.e2e.ts"
  ],
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "githubPages": true
}
